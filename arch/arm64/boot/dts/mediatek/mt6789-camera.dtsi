/* MT6789 camera blocks - split out of the soc node by tools/scripts/dts-socsplit.py */

&soc {
	seninf1@1a004000 {
		compatible = "mediatek,seninf1";
		reg = <0x00 0x1a004000 0x00 0x1000>;
	};

	seninf2@1a005000 {
		compatible = "mediatek,seninf2";
		reg = <0x00 0x1a005000 0x00 0x1000>;
	};

	seninf3@1a006000 {
		compatible = "mediatek,seninf3";
		reg = <0x00 0x1a006000 0x00 0x1000>;
	};

	seninf4@1a007000 {
		compatible = "mediatek,seninf4";
		reg = <0x00 0x1a007000 0x00 0x1000>;
	};

	seninf5@1a008000 {
		compatible = "mediatek,seninf5";
		reg = <0x00 0x1a008000 0x00 0x1000>;
	};

	seninf6@1a009000 {
		compatible = "mediatek,seninf6";
		reg = <0x00 0x1a009000 0x00 0x1000>;
	};

	seninf_top: seninf_top@1a004000 {
		compatible = "mediatek,seninf_top";
		reg = <0x00 0x1a004000 0x00 0x1000>;
		power-domains = <&scpsys MT6789_POWER_DOMAIN_CAM>;
		mediatek,platform = "mt6789";
		mediatek,seninf_max_num = "6";
		clocks = <&camsys_main_clk CLK_CAM_M_SENINF &topckgen_clk CLK_TOP_SENINF_SEL &topckgen_clk CLK_TOP_SENINF1_SEL &topckgen_clk CLK_TOP_SENINF2_SEL &topckgen_clk CLK_TOP_SENINF3_SEL &topckgen_clk CLK_TOP_CAMTG_SEL &topckgen_clk CLK_TOP_CAMTG2_SEL &topckgen_clk CLK_TOP_CAMTG3_SEL &topckgen_clk CLK_TOP_CAMTG4_SEL &topckgen_clk CLK_TOP_TCK_26M_MX9 &topckgen_clk CLK_TOP_UNIVPLL_192M_D8 &topckgen_clk CLK_TOP_UNIVPLL_D6_D8 &topckgen_clk CLK_TOP_UNIVPLL_192M_D4 &topckgen_clk CLK_TOP_F26M_CK_D2 &topckgen_clk CLK_TOP_UNIVPLL_192M_D16 &topckgen_clk CLK_TOP_UNIVPLL_192M_D32>;
		clock-names = "CAMSYS_SENINF_CGPDN", "TOP_MUX_SENINF", "TOP_MUX_SENINF1", "TOP_MUX_SENINF2", "TOP_MUX_SENINF3", "TOP_MUX_CAMTG", "TOP_MUX_CAMTG2", "TOP_MUX_CAMTG3", "TOP_MUX_CAMTG4", "TOP_CLK26M", "TOP_UNIVP_192M_D8", "TOP_UNIVPLL_D6_D8", "TOP_UNIVP_192M_D4", "TOP_F26M_CK_D2", "TOP_UNIVP_192M_D16", "TOP_UNIVP_192M_D32";
		operating-points-v2 = <&opp_table_cam>;
		dvfsrc-vcore-supply = <&dvfsrc_vcore>;
	};


	kd_camera_hw1: kd_camera_hw1@1a004000 {
		compatible = "mediatek,imgsensor";
		pinctrl-names = "default", "cam0_rst0", "cam0_rst1", "cam1_rst0", "cam1_rst1", "cam1_pnd0", "cam1_pnd1", "cam2_rst0", "cam2_rst1", "cam3_rst0", "cam3_rst1", "cam0_ldo_vcamio_0", "cam0_ldo_vcamio_1", "cam1_ldo_vcamio_0", "cam1_ldo_vcamio_1", "cam2_ldo_vcamio_0", "cam2_ldo_vcamio_1", "cam2_ldo_vcama_0", "cam2_ldo_vcama_1", "cam3_ldo_vcama_0", "cam3_ldo_vcama_1", "cam0_mclk_off", "cam0_mclk_2mA", "cam0_mclk_4mA", "cam0_mclk_6mA", "cam0_mclk_8mA", "cam1_mclk_off", "cam1_mclk_2mA", "cam1_mclk_4mA", "cam1_mclk_6mA", "cam1_mclk_8mA", "cam2_mclk_off", "cam2_mclk_2mA", "cam2_mclk_4mA", "cam2_mclk_6mA", "cam2_mclk_8mA", "cam3_mclk_off", "cam3_mclk_2mA", "cam3_mclk_4mA", "cam3_mclk_6mA", "cam3_mclk_8mA", "cam0_ldo_vs2pmu_0", "cam0_ldo_vs2pmu_1", "cam1_ldo_vs2pmu_0", "cam1_ldo_vs2pmu_1";
		pinctrl-0 = <&camera_pins_default>;
		pinctrl-1 = <&camera_pins_cam0_rst_0>;
		pinctrl-2 = <&camera_pins_cam0_rst_1>;
		pinctrl-3 = <&camera_pins_cam1_rst_0>;
		pinctrl-4 = <&camera_pins_cam1_rst_1>;
		pinctrl-5 = <&camera_pins_cam1_pdn_0>;
		pinctrl-6 = <&camera_pins_cam1_pdn_1>;
		pinctrl-7 = <&camera_pins_cam2_rst_0>;
		pinctrl-8 = <&camera_pins_cam2_rst_1>;
		pinctrl-9 = <&camera_pins_cam3_rst_0>;
		pinctrl-10 = <&camera_pins_cam3_rst_1>;
		pinctrl-11 = <&camera_pins_cam0_vcamio_0>;
		pinctrl-12 = <&camera_pins_cam0_vcamio_1>;
		pinctrl-13 = <&camera_pins_cam0_vcamio_0>;
		pinctrl-14 = <&camera_pins_cam0_vcamio_1>;
		pinctrl-15 = <&camera_pins_cam0_vcamio_0>;
		pinctrl-16 = <&camera_pins_cam0_vcamio_1>;
		pinctrl-17 = <&camera_pins_cam2_vcama_0>;
		pinctrl-18 = <&camera_pins_cam2_vcama_1>;
		pinctrl-19 = <&camera_pins_cam3_vcama_0>;
		pinctrl-20 = <&camera_pins_cam3_vcama_1>;
		pinctrl-21 = <&camera_pins_cam0_mclk_off>;
		pinctrl-22 = <&camera_pins_cam0_mclk_2ma>;
		pinctrl-23 = <&camera_pins_cam0_mclk_4ma>;
		pinctrl-24 = <&camera_pins_cam0_mclk_6ma>;
		pinctrl-25 = <&camera_pins_cam0_mclk_8ma>;
		pinctrl-26 = <&camera_pins_cam1_mclk_off>;
		pinctrl-27 = <&camera_pins_cam1_mclk_2ma>;
		pinctrl-28 = <&camera_pins_cam1_mclk_4ma>;
		pinctrl-29 = <&camera_pins_cam1_mclk_6ma>;
		pinctrl-30 = <&camera_pins_cam1_mclk_8ma>;
		pinctrl-31 = <&camera_pins_cam2_mclk_off>;
		pinctrl-32 = <&camera_pins_cam2_mclk_2ma>;
		pinctrl-33 = <&camera_pins_cam2_mclk_4ma>;
		pinctrl-34 = <&camera_pins_cam2_mclk_6ma>;
		pinctrl-35 = <&camera_pins_cam2_mclk_8ma>;
		pinctrl-36 = <&camera_pins_cam2_mclk_off>;
		pinctrl-37 = <&camera_pins_cam2_mclk_2ma>;
		pinctrl-38 = <&camera_pins_cam2_mclk_4ma>;
		pinctrl-39 = <&camera_pins_cam2_mclk_6ma>;
		pinctrl-40 = <&camera_pins_cam2_mclk_8ma>;
		pinctrl-41 = <&camera_pins_ldo_vs2pmu_0>;
		pinctrl-42 = <&camera_pins_ldo_vs2pmu_1>;
		pinctrl-43 = <&camera_pins_ldo_vs2pmu_0>;
		pinctrl-44 = <&camera_pins_ldo_vs2pmu_1>;
		cam0_pin_mclk = "mclk";
		cam0_pin_rst = "gpio";
		cam0_pin_vs2pmu = "gpio";
		cam0_pin_vcama = "regulator";
		cam0_pin_vcamio = "gpio";
		cam0_pin_vcamd = "regulator";
		cam1_pin_mclk = "mclk";
		cam1_pin_rst = "gpio";
		cam1_pin_pdn = "gpio";
		cam1_pin_vs2pmu = "gpio";
		cam1_pin_exta2 = "regulator";
		cam1_pin_vcamio = "gpio";
		cam1_pin_extd2 = "regulator";
		cam2_pin_mclk = "mclk";
		cam2_pin_rst = "gpio";
		cam2_pin_vcama = "gpio";
		cam2_pin_vcamio = "gpio";
		cam3_pin_mclk = "mclk";
		cam3_pin_rst = "gpio";
		cam3_pin_vcama = "gpio";
		cam0_enable_sensor = "s5khm6sx_mipi_raw";
		cam1_enable_sensor = "gc32e1_mipi_raw";
		cam2_enable_sensor = "gc02m1macro_mipi_raw";
		cam3_enable_sensor = "fake_serial_yuv";
		camera_input_gpio = <0x4d 0x35 0x00>;
		status = "okay";
	};

	seninf_n3d_top: seninf_n3d_top@1a004000 {
		compatible = "mediatek,seninf_n3d_top";
		interrupts = <GIC_SPI 351 IRQ_TYPE_LEVEL_HIGH 0>;
		power-domains = <&scpsys MT6789_POWER_DOMAIN_CAM>;
		reg = <0x00 0x1a004000 0x00 0x100 0x00 0x1a004100 0x00 0x100 0x00 0x1a004200 0x00 0x100>;
		reg-names = "seninf_top", "seninf_n3d_a", "seninf_n3d_b";
		clocks = <&camsys_main_clk CLK_CAM_M_SENINF &camsys_main_clk CLK_CAM_M_CAM &camsys_main_clk CLK_CAM_M_CAMTG &topckgen_clk CLK_TOP_CAMTM_SEL>;
		clock-names = "CAMSYS_SENINF_CGPDN", "CAMSYS_CAM_CGPDN", "CAMSYS_CAMTG_CGPDN", "CAMSYS_CAMTM_SEL";
	};

	img1_smi_2x1_sub_common: img1_smi_2x1_sub_comm@1401e000 {
		compatible = "mediatek,mt6789-smi-common", "syscon", "mediatek,smi-common", "mediatek,smi-sub-common";
		reg = <0x00 0x1401e000 0x00 0x1000>;
		mediatek,smi = <&smi_disp_common>;
		mediatek,common-id = <0x03>;
		power-domains = <&scpsys MT6789_POWER_DOMAIN_DISP>;
		clocks = <&dispsys_config_clk CLK_MM_SMI_INFRA &dispsys_config_clk CLK_MM_SMI_COMMON &dispsys_config_clk CLK_MM_SMI_GALS &dispsys_config_clk CLK_MM_SMI_IOMMU>;
		clock-names = "apb", "smi", "gals0", "gals1";
	};

	img0_smi_2x1_sub_common: img0_smi_2x1_sub_comm@1502f000 {
		compatible = "mediatek,mt6789-smi-common", "syscon", "mediatek,smi-common", "mediatek,smi-sub-common";
		reg = <0x00 0x1502f000 0x00 0x1000>;
		mediatek,smi = <&img1_smi_2x1_sub_common>;
		mediatek,common-id = <0x04>;
		power-domains = <&scpsys MT6789_POWER_DOMAIN_ISP>;
		clocks = <&imgsys1_clk CLK_IMGSYS1_LARB9 &imgsys1_clk CLK_IMGSYS1_LARB10 &imgsys1_clk CLK_IMGSYS1_DIP &imgsys1_clk CLK_IMGSYS1_GALS>;
		clock-names = "apb", "smi", "gals0", "gals1";
	};

	ipe_smi_2x1_sub_common: ipe_smi_2x1_sub_comm@1b00e000 {
		compatible = "mediatek,mt6789-smi-common", "syscon", "mediatek,smi-common", "mediatek,smi-sub-common";
		reg = <0x00 0x1b00e000 0x00 0x1000>;
		mediatek,smi = <&img1_smi_2x1_sub_common>;
		mediatek,common-id = <0x05>;
		power-domains = <&scpsys MT6789_POWER_DOMAIN_IPE>;
		clocks = <&ipesys_clk CLK_IPE_SMI_SUBCOM &ipesys_clk CLK_IPE_SMI_SUBCOM &ipesys_clk CLK_IPE_SMI_SUBCOM &ipesys_clk CLK_IPE_SMI_SUBCOM>;
		clock-names = "apb", "smi", "gals0", "gals1";
	};

	cam_smi_3x1_sub_common1: cam_smi_3x1_sub_comm1@1a00c000 {
		compatible = "mediatek,mt6789-smi-common", "syscon", "mediatek,smi-common", "mediatek,smi-sub-common";
		reg = <0x00 0x1a00c000 0x00 0x1000>;
		mediatek,smi = <&smi_disp_common>;
		mediatek,common-id = <0x06>;
		power-domains = <&scpsys MT6789_POWER_DOMAIN_CAM>;
		clocks = <&camsys_main_clk CLK_CAM_M_LARB14 &camsys_main_clk CLK_CAM_M_CAM &camsys_main_clk CLK_CAM_M_LARB14 &camsys_main_clk CLK_CAM_M_CAM>;
		clock-names = "apb", "smi", "gals0", "gals1";
	};

	cam_smi_4x1_sub_common0: cam_smi_4x1_sub_comm0@1a00d000 {
		compatible = "mediatek,mt6789-smi-common", "syscon", "mediatek,smi-common", "mediatek,smi-sub-common";
		reg = <0x00 0x1a00d000 0x00 0x1000>;
		mediatek,smi = <&smi_disp_common>;
		mediatek,common-id = <0x07>;
		power-domains = <&scpsys MT6789_POWER_DOMAIN_CAM>;
		clocks = <&camsys_main_clk CLK_CAM_M_LARB13 &camsys_main_clk CLK_CAM_M_CAM &camsys_main_clk CLK_CAM_M_LARB13 &camsys_main_clk CLK_CAM_M_CAM>;
		clock-names = "apb", "smi", "gals0", "gals1";
	};

	imgsys-config-bus {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		dma-ranges = <0x02 0x00 0x02 0x00 0x01 0x00>;

		imgsys_config: imgsys_config@15020000 {
			#address-cells = <2>;
			#size-cells = <2>;
			compatible = "mediatek,imgsys", "syscon";
			reg = <0x00 0x15020000 0x00 0x1000>;
			power-domains = <&scpsys MT6789_POWER_DOMAIN_ISP>;
			mediatek,larb = <&smi_larb9>;
			iommus = <&disp_iommu 0x20120 &disp_iommu 0x20121 &disp_iommu 0x20122 &disp_iommu 0x20123 &disp_iommu 0x20124 &disp_iommu 0x20125 &disp_iommu 0x20126 &disp_iommu 0x20127 &disp_iommu 0x20128 &disp_iommu 0x20129 &disp_iommu 0x2012a &disp_iommu 0x2012b &disp_iommu 0x2012c &disp_iommu 0x2012d &disp_iommu 0x2012e>;
			clocks = <&imgsys1_clk CLK_IMGSYS1_LARB9 &imgsys1_clk CLK_IMGSYS1_DIP>;
			clock-names = "DIP_CG_IMG_LARB9", "DIP_CG_IMG_DIP";
		};
	};

	dip_a0@15021000 {
		compatible = "mediatek,dip1";
		reg = <0x00 0x15021000 0x00 0xc000>;
		interrupts = <GIC_SPI 378 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	dip_a1@15022000 {
		compatible = "mediatek,dip_a1";
		reg = <0x00 0x15022000 0x00 0x1000>;
	};

