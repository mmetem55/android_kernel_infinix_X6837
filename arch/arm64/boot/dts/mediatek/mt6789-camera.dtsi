	aie-bus {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		dma-ranges = <0x02 0x00 0x02 0x00 0x01 0x00>;

		aie@1b001000 {
			#address-cells = <2>;
			#size-cells = <2>;
			compatible = "mediatek,mt6789-aie", "mediatek,aie-hw2.0";
			reg = <0x00 0x1b001000 0x00 0x1000>;
			interrupts = <GIC_SPI 391 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&scpsys MT6789_POWER_DOMAIN_IPE>;
			clocks = <&ipesys_clk CLK_IPE_FD &ipesys_clk CLK_IPE_LARB20>;
			clock-names = "aie", "FDVT_CLK_IPE_LARB20";
			mboxes = <&gce 0x14 0x00 0x01 &gce_sec 0xb 0x00 0x01>;
			iommus = <&disp_iommu 0x20280 &disp_iommu 0x20281 &disp_iommu 0x20282 &disp_iommu 0x20283>;
			fdvt_frame_done = <0xb1>;
			mediatek,larb = <&smi_larb20>;
		};
	};

	fe@1b002000 {
		compatible = "mediatek,fe";
		reg = <0x00 0x1b002000 0x00 0x1000>;
		interrupts = <GIC_SPI 393 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	rsc-bus {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		dma-ranges = <0x02 0x00 0x02 0x00 0x01 0x00>;

		rsc@1b003000 {
			#address-cells = <2>;
			#size-cells = <2>;
			compatible = "mediatek,rsc";
			mediatek,larb = <&smi_larb20>;
			power-domains = <&scpsys MT6789_POWER_DOMAIN_IPE>;
			iommus = <&disp_iommu 0x20284 &disp_iommu 0x20285>;
			reg = <0x00 0x1b003000 0x00 0x1000>;
			interrupts = <GIC_SPI 392 IRQ_TYPE_LEVEL_HIGH 0>;
			mboxes = <&gce 0x15 0x00 0x01>;
			gce-event-names = "rsc_eof";
			gce-events = <&gce 0xb3>;
			clocks = <&ipesys_clk CLK_IPE_RSC &ipesys_clk CLK_IPE_LARB20>;
			clock-names = "RSC_CLK_IPE_RSC", "RSC_CLK_IPE_LARB20";
		};
	};

	depth@1b100000 {
		compatible = "mediatek,depth";
		reg = <0x00 0x1b100000 0x00 0x1000>;
		interrupts = <GIC_SPI 394 IRQ_TYPE_LEVEL_HIGH 0>;
	};

};
