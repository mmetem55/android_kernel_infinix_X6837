	};
};

&pio {
	gpio_i2c_sclk_mode: i2c_sclk_mode {
		pins_cmd_dat {
			pinmux = <0x9401>;
			drive-strength = <0x03>;
			mediatek,drive-strength-adv = <0x00>;
			bias-pull-up = <0xcd>;
		};
	};

	gpio_i2c_sda_mode: i2c_sda_mode {
		pins_cmd_dat {
			pinmux = <0x9501>;
			drive-strength = <0x03>;
			mediatek,drive-strength-adv = <0x00>;
			bias-pull-up = <0xcd>;
		};
	};
};

&odm {
	tran_battery: tran_battery {
		compatible = "tran,chg_fun";
		status = "okay";
		bootmode = <&chosen>;
		enable_pcb_tml;
		pcb_temp_step_one = <0x9470>;
		pcb_cur_step_one = <0x190>;
		pcb_temp_step_two = <0xa410>;
		pcb_cur_step_two = <0x190>;
		pcb_min_chg_cur = <0xf4240>;
		jeita_below_t0_chg_cur = <0x00>;
		jeita_t0_to_t1_chg_cur = <0xf4240>;
		jeita_t2_to_t3_chg_cur = <0x1e8480>;
		jeita_t3_to_t4_chg_cur = <0x1e8480>;
		jeita_above_t4_chg_cur = <0x00>;
		jeita_below_t0_input_cur = <0x16e360>;
		jeita_t0_to_t1_input_cur = <0x16e360>;
		jeita_t2_to_t3_input_cur = <0x200b20>;
		jeita_t3_to_t4_input_cur = <0x200b20>;
		jeita_above_t4_input_cur = <0xf4240>;
	};

	tran_battery_aging: tran_battery_aging {
		compatible = "tran,chg_aging";
		status = "okay";
		battery_aging_module0 = <0x00>;
		battery_aging_module1 = <0x00>;
		battery_aging_module2 = <0x00>;
		battery_aging_module3 = <0x00>;
	};

	tran_auto_test: tran_auto_test {
		compatible = "tran,auto_test";
		status = "okay";
	};

	tran_otg: tran_otg {
		compatible = "tran,otg_fun";
		pinctrl-names = "otg_gpio_init", "otg_gpio_low", "otg_gpio_high", "meta_gpio_init", "meta_gpio_low", "meta_gpio_high";
		pinctrl-0 = <&gpio_otg>;
		pinctrl-1 = <&gpio_otg_low>;
		pinctrl-2 = <&gpio_otg_high>;
		pinctrl-3 = <&gpio_meta>;
		pinctrl-4 = <&gpio_meta_low>;
		pinctrl-5 = <&gpio_meta_high>;
		support_otg_dcp;
		otg_dcp_ctrl_type = <0x02>;
	};

	smart_charging {
		compatible = "tran,smart_charging";
		smartchg_min_cur = <0x7a120>;
		status = "okay";
	};

	water_detect: water_detect {
		status = "okay";
		compatible = "transsion, water_detect";
		bootmode = <&chosen>;
		polling_interval = <0x05>;
		scheme = <0x01>;
		gpio_x = <&pio 0x15 0x00>;
		gpio_y = <&pio 0x3e 0x00>;
	};
};

&pio {
	gpio_otg: otg_init {
		pins_cmd_dat {
			pinmux = <0x1a00>;
			slew-rate = <0x01>;
		};
	};

	gpio_otg_low: otg_low {
		pins_cmd_dat {
			pinmux = <0x1a00>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	gpio_otg_high: otg_high {
		pins_cmd_dat {
			pinmux = <0x1a00>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	gpio_meta: meta_init {
		pins_cmd_dat {
			pinmux = <0x1800>;
			slew-rate = <0x01>;
		};
	};

	gpio_meta_low: meta_low {
		pins_cmd_dat {
			pinmux = <0x1800>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	gpio_meta_high: meta_high {
		pins_cmd_dat {
			pinmux = <0x1800>;
			slew-rate = <0x01>;
			output-high;
		};
	};
};

