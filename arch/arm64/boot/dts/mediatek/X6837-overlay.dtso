/dts-v1/;
/plugin/;

&pio {
	camera_pins_cam0_rst_0: cam0@0 {
		pins_cmd_dat {
			pinmux = <0x1200>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	camera_pins_cam0_rst_1: cam0@1 {
		pins_cmd_dat {
			pinmux = <0x1200>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	camera_pins_cam1_rst_0: cam1@0 {
		pins_cmd_dat {
			pinmux = <0x1000>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	camera_pins_cam1_rst_1: cam1@1 {
		pins_cmd_dat {
			pinmux = <0x1000>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	camera_pins_cam1_pdn_0: cam1pdn@0 {
		pins_cmd_dat {
			pinmux = <0x1100>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	camera_pins_cam1_pdn_1: cam1pdn@1 {
		pins_cmd_dat {
			pinmux = <0x1100>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	camera_pins_cam2_rst_0: cam2@0 {
		pins_cmd_dat {
			pinmux = <0x1600>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	camera_pins_cam2_rst_1: cam2@1 {
		pins_cmd_dat {
			pinmux = <0x1600>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	camera_pins_cam3_rst_0: cam3@0 {
		pins_cmd_dat {
			pinmux = <0x1400>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	camera_pins_cam3_rst_1: cam3@1 {
		pins_cmd_dat {
			pinmux = <0x1400>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	camera_pins_cam0_mclk_off: camera_pins_cam0_mclk_off {
		pins_cmd_dat {
			pinmux = <0x8100>;
			drive-strength = <0x01>;
		};
	};

	camera_pins_cam0_mclk_2ma: camera_pins_cam0_mclk_2ma {
		pins_cmd_dat {
			pinmux = <0x8101>;
			drive-strength = <0x00>;
		};
	};

	camera_pins_cam0_mclk_4ma: camera_pins_cam0_mclk_4ma {
		pins_cmd_dat {
			pinmux = <0x8101>;
			drive-strength = <0x01>;
		};
	};

	camera_pins_cam0_mclk_6ma: camera_pins_cam0_mclk_6ma {
		pins_cmd_dat {
			pinmux = <0x8101>;
			drive-strength = <0x02>;
		};
	};

	camera_pins_cam0_mclk_8ma: camera_pins_cam0_mclk_8ma {
		pins_cmd_dat {
			pinmux = <0x8101>;
			drive-strength = <0x03>;
		};
	};

	camera_pins_cam1_mclk_off: camera_pins_cam1_mclk_off {
		pins_cmd_dat {
			pinmux = <0x7e00>;
			drive-strength = <0x01>;
		};
	};

	camera_pins_cam1_mclk_2ma: camera_pins_cam1_mclk_2ma {
		pins_cmd_dat {
			pinmux = <0x7e01>;
			drive-strength = <0x00>;
		};
	};

	camera_pins_cam1_mclk_4ma: camera_pins_cam1_mclk_4ma {
		pins_cmd_dat {
			pinmux = <0x7e01>;
			drive-strength = <0x01>;
		};
	};

	camera_pins_cam1_mclk_6ma: camera_pins_cam1_mclk_6ma {
		pins_cmd_dat {
			pinmux = <0x7e01>;
			drive-strength = <0x02>;
		};
	};

	camera_pins_cam1_mclk_8ma: camera_pins_cam1_mclk_8ma {
		pins_cmd_dat {
			pinmux = <0x7e01>;
			drive-strength = <0x03>;
		};
	};

	camera_pins_cam2_mclk_off: camera_pins_cam2_mclk_off {
		pins_cmd_dat {
			pinmux = <0x7f00>;
			drive-strength = <0x01>;
		};
	};

	camera_pins_cam2_mclk_2ma: camera_pins_cam2_mclk_2ma {
		pins_cmd_dat {
			pinmux = <0x7f01>;
			drive-strength = <0x00>;
		};
	};

	camera_pins_cam2_mclk_4ma: camera_pins_cam2_mclk_4ma {
		pins_cmd_dat {
			pinmux = <0x7f01>;
			drive-strength = <0x01>;
		};
	};

	camera_pins_cam2_mclk_6ma: camera_pins_cam2_mclk_6ma {
		pins_cmd_dat {
			pinmux = <0x7f01>;
			drive-strength = <0x02>;
		};
	};

	camera_pins_cam2_mclk_8ma: camera_pins_cam2_mclk_8ma {
		pins_cmd_dat {
			pinmux = <0x7f01>;
			drive-strength = <0x03>;
		};
	};

	camera_pins_cam0_vcamio_0: cam0@vcamio0 {
		pins_cmd_dat {
			pinmux = <0x3300>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	camera_pins_cam0_vcamio_1: cam0@vcamio1 {
		pins_cmd_dat {
			pinmux = <0x3300>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	camera_pins_cam2_vcama_0: cam2@vcama0 {
		pins_cmd_dat {
			pinmux = <0x300>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	camera_pins_cam2_vcama_1: cam2@vcama1 {
		pins_cmd_dat {
			pinmux = <0x300>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	camera_pins_cam3_vcama_0: cam3@vcama0 {
		pins_cmd_dat {
			pinmux = <0x300>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	camera_pins_cam3_vcama_1: cam3@vcama1 {
		pins_cmd_dat {
			pinmux = <0x300>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	camera_pins_ldo_vs2pmu_0: cam0@vs2pmu0 {
		pins_cmd_dat {
			pinmux = <0x9a00>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	camera_pins_ldo_vs2pmu_1: cam0@vs2pmu1 {
		pins_cmd_dat {
			pinmux = <0x9a00>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	camera_pins_default: camdefault {
	};
};

&kd_camera_hw1 {
	pinctrl-names = "default", "cam0_rst0", "cam0_rst1", "cam1_rst0", "cam1_rst1", "cam1_pnd0", "cam1_pnd1", "cam2_rst0", "cam2_rst1", "cam3_rst0", "cam3_rst1", "cam0_ldo_vcamio_0", "cam0_ldo_vcamio_1", "cam1_ldo_vcamio_0", "cam1_ldo_vcamio_1", "cam2_ldo_vcamio_0", "cam2_ldo_vcamio_1", "cam2_ldo_vcama_0", "cam2_ldo_vcama_1", "cam3_ldo_vcama_0", "cam3_ldo_vcama_1", "cam0_mclk_off", "cam0_mclk_2mA", "cam0_mclk_4mA", "cam0_mclk_6mA", "cam0_mclk_8mA", "cam1_mclk_off", "cam1_mclk_2mA", "cam1_mclk_4mA", "cam1_mclk_6mA", "cam1_mclk_8mA", "cam2_mclk_off", "cam2_mclk_2mA", "cam2_mclk_4mA", "cam2_mclk_6mA", "cam2_mclk_8mA", "cam3_mclk_off", "cam3_mclk_2mA", "cam3_mclk_4mA", "cam3_mclk_6mA", "cam3_mclk_8mA", "cam0_ldo_vs2pmu_0", "cam0_ldo_vs2pmu_1", "cam1_ldo_vs2pmu_0", "cam1_ldo_vs2pmu_1";
	pinctrl-0 = <&camera_pins_default>;
	pinctrl-1 = <&camera_pins_cam0_rst_0>;
	pinctrl-2 = <&camera_pins_cam0_rst_1>;
	pinctrl-3 = <&camera_pins_cam1_rst_0>;
	pinctrl-4 = <&camera_pins_cam1_rst_1>;
	pinctrl-5 = <&camera_pins_cam1_pdn_0>;
	pinctrl-6 = <&camera_pins_cam1_pdn_1>;
	pinctrl-7 = <&camera_pins_cam2_rst_0>;
	pinctrl-8 = <&camera_pins_cam2_rst_1>;
	pinctrl-9 = <&camera_pins_cam3_rst_0>;
	pinctrl-10 = <&camera_pins_cam3_rst_1>;
	pinctrl-11 = <&camera_pins_cam0_vcamio_0>;
	pinctrl-12 = <&camera_pins_cam0_vcamio_1>;
	pinctrl-13 = <&camera_pins_cam0_vcamio_0>;
	pinctrl-14 = <&camera_pins_cam0_vcamio_1>;
	pinctrl-15 = <&camera_pins_cam0_vcamio_0>;
	pinctrl-16 = <&camera_pins_cam0_vcamio_1>;
	pinctrl-17 = <&camera_pins_cam2_vcama_0>;
	pinctrl-18 = <&camera_pins_cam2_vcama_1>;
	pinctrl-19 = <&camera_pins_cam3_vcama_0>;
	pinctrl-20 = <&camera_pins_cam3_vcama_1>;
	pinctrl-21 = <&camera_pins_cam0_mclk_off>;
	pinctrl-22 = <&camera_pins_cam0_mclk_2ma>;
	pinctrl-23 = <&camera_pins_cam0_mclk_4ma>;
	pinctrl-24 = <&camera_pins_cam0_mclk_6ma>;
	pinctrl-25 = <&camera_pins_cam0_mclk_8ma>;
	pinctrl-26 = <&camera_pins_cam1_mclk_off>;
	pinctrl-27 = <&camera_pins_cam1_mclk_2ma>;
	pinctrl-28 = <&camera_pins_cam1_mclk_4ma>;
	pinctrl-29 = <&camera_pins_cam1_mclk_6ma>;
	pinctrl-30 = <&camera_pins_cam1_mclk_8ma>;
	pinctrl-31 = <&camera_pins_cam2_mclk_off>;
	pinctrl-32 = <&camera_pins_cam2_mclk_2ma>;
	pinctrl-33 = <&camera_pins_cam2_mclk_4ma>;
	pinctrl-34 = <&camera_pins_cam2_mclk_6ma>;
	pinctrl-35 = <&camera_pins_cam2_mclk_8ma>;
	pinctrl-36 = <&camera_pins_cam2_mclk_off>;
	pinctrl-37 = <&camera_pins_cam2_mclk_2ma>;
	pinctrl-38 = <&camera_pins_cam2_mclk_4ma>;
	pinctrl-39 = <&camera_pins_cam2_mclk_6ma>;
	pinctrl-40 = <&camera_pins_cam2_mclk_8ma>;
	pinctrl-41 = <&camera_pins_ldo_vs2pmu_0>;
	pinctrl-42 = <&camera_pins_ldo_vs2pmu_1>;
	pinctrl-43 = <&camera_pins_ldo_vs2pmu_0>;
	pinctrl-44 = <&camera_pins_ldo_vs2pmu_1>;
	cam0_pin_mclk = "mclk";
	cam0_pin_rst = "gpio";
	cam0_pin_vs2pmu = "gpio";
	cam0_pin_vcama = "regulator";
	cam0_pin_vcamio = "gpio";
	cam0_pin_vcamd = "regulator";
	cam1_pin_mclk = "mclk";
	cam1_pin_rst = "gpio";
	cam1_pin_pdn = "gpio";
	cam1_pin_vs2pmu = "gpio";
	cam1_pin_exta2 = "regulator";
	cam1_pin_vcamio = "gpio";
	cam1_pin_extd2 = "regulator";
	cam2_pin_mclk = "mclk";
	cam2_pin_rst = "gpio";
	cam2_pin_vcama = "gpio";
	cam2_pin_vcamio = "gpio";
	cam3_pin_mclk = "mclk";
	cam3_pin_rst = "gpio";
	cam3_pin_vcama = "gpio";
	cam0_enable_sensor = "s5khm6sx_mipi_raw";
	cam1_enable_sensor = "gc32e1_mipi_raw";
	cam2_enable_sensor = "gc02m1macro_mipi_raw";
	cam3_enable_sensor = "fake_serial_yuv";
	camera_input_gpio = <&pio 0x35 0x00>;
	status = "okay";
};

&i2c2 {
	status = "okay";
	clock-frequency = <0xf4240>;
	#address-cells = <0x01>;
	#size-cells = <0x00>;

	mtk_camera_eeprom0: camera_eeprom0@50 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x50>;
		status = "okay";
	};

	camera_main_mtk: camera_main@1a {
		compatible = "mediatek,camera_main";
		#thermal-sensor-cells = <0x00>;
		reg = <0x2a>;
		status = "okay";
	};

	camera_main_af_mtk: camera_main_af@0c {
		compatible = "mediatek,camera_main_af";
		reg = <0x0c>;
		status = "okay";
	};
};

&i2c8 {
	status = "okay";
	clock-frequency = <0x61a80>;
	#address-cells = <0x01>;
	#size-cells = <0x00>;

	mtk_camera_eeprom1: camera_eeprom1@51 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x51>;
		status = "okay";
	};

	camera_sub_mtk: camera_sub@10 {
		compatible = "mediatek,camera_sub";
		#thermal-sensor-cells = <0x00>;
		reg = <0x10>;
		status = "okay";
	};
};

&i2c4 {
	status = "okay";
	clock-frequency = <0x61a80>;
	#address-cells = <0x01>;
	#size-cells = <0x00>;

	camera_main_two_mtk: camera_main_two@10 {
		compatible = "mediatek,camera_main_two";
		#thermal-sensor-cells = <0x00>;
		reg = <0x10>;
		status = "okay";
	};
};

&pio {
	ext_ldo_pins_default: extldodefault {
	};

	ext_ldo_pins_hwen_high: extldo_en_high {
		pins_cmd_dat {
			pinmux = <0x9900>;
			output-high;
		};
	};

	ext_ldo_pins_hwen_low: extldo_en_low {
		pins_cmd_dat {
			pinmux = <0x9900>;
			output-low;
		};
	};
};

&odm {
	cam_vdd_extldo: cam_vdd_extldo {
		compatible = "mediatek,cam_vdd_extldo";
		pinctrl-names = "extldodefault", "extldo_en_high", "extldo_en_low";
		pinctrl-0 = <&ext_ldo_pins_default>;
		pinctrl-1 = <&ext_ldo_pins_hwen_high>;
		pinctrl-2 = <&ext_ldo_pins_hwen_low>;
		status = "okay";
	};
};

&i2c7 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;

	cam_vdd_ext@28 {
		compatible = "mediatek,cam_vdd_ext";
		reg = <0x28>;
		status = "okay";
	};
};

&i2c5 {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	clock-frequency = <0x61a80>;
	mediatek,use-open-drain;

	strobe_main_mtk: strobe_main@63 {
		compatible = "mediatek,strobe_main";
		reg = <0x63>;
		status = "okay";
	};
};

&odm {
	flashlights_ocp81375: flashlights_ocp81375 {
		compatible = "mediatek,flashlights_ocp81375";
		status = "okay";
		ocp81375_regulator-supply = <&flashlight_gpio157>;
	};

	flashlight_gpio157: flashlight_gpio157 {
		compatible = "regulator-fixed";
		regulator-name = "flashlight_gpio157";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		gpio = <&pio 0x9d 0x00>;
		enable-active-high;
	};
};

&camera_af_hw_node {
	camaf_m1_pmic-supply = <&mt6358_vio28_reg>;
	status = "okay";
};

&thermal_zones {
	camera_main: camera_main {
		polling-delay = <0x3e8>;
		polling-delay-passive = <0x00>;
		thermal-sensors = <&camera_main_mtk>;
	};

	camera_sub: camera_sub {
		polling-delay = <0x3e8>;
		polling-delay-passive = <0x00>;
		thermal-sensors = <&camera_sub_mtk>;
	};

	camera_main_two: camera_main_two {
		polling-delay = <0x3e8>;
		polling-delay-passive = <0x00>;
		thermal-sensors = <&camera_main_two_mtk>;
	};
};

&chosen {
};

&i2c5 {
	i2c_lcd_bias@3e {
		compatible = "mediatek,i2c_lcd_bias";
		reg = <0x3e>;
		status = "okay";
	};
};

&mtk_leds {
	compatible = "mediatek,pwm-leds";

	backlight {
		led_mode = <0x05>;
		pwm_config = <0x03 0x00 0x00 0x00 0x00>;
		pwms = <&disp_pwm 0x00 0x99d9>;
		pwm-names = "lcd-backlight";
		max-brightness = <0xfff>;
		max-hw-brightness = <0xfff>;
	};
};

&pio {
	mtkfb_pins_lcm_reset0: lcm_rst_out0_gpio {
		pins_cmd_dat {
			pinmux = <0x5500>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	mtkfb_pins_lcm_reset1: lcm_rst_out1_gpio {
		pins_cmd_dat {
			pinmux = <0x5500>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	mtkfb_pins_lcd_bias_enp0: lcd_bias_enp0_gpio {
		pins_cmd_dat {
			pinmux = <0x3700>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	mtkfb_pins_lcd_bias_enp1: lcd_bias_enp1_gpio {
		pins_cmd_dat {
			pinmux = <0x3700>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	mtkfb_pins_lcd_bias_enn0: lcd_bias_enn0_gpio {
		pins_cmd_dat {
			pinmux = <0x3600>;
			slew-rate = <0x01>;
			output-low;
		};
	};

	mtkfb_pins_lcd_bias_enn1: lcd_bias_enn1_gpio {
		pins_cmd_dat {
			pinmux = <0x3600>;
			slew-rate = <0x01>;
			output-high;
		};
	};

	mtkfb_pins_lcm_dsi_te: lcm_dsi_te {
		pins_cmd_dat {
			pinmux = <0x5301>;
		};
	};

	mtkfb_pins_default: dispdefault {
	};
};

&mtkfb {
	pinctrl-names = "dispdefault", "lcm_rst_out0_gpio", "lcm_rst_out1_gpio", "lcd_bias_enp0_gpio", "lcd_bias_enp1_gpio", "lcd_bias_enn0_gpio", "lcd_bias_enn1_gpio";
	pinctrl-0 = <&mtkfb_pins_default>;
	pinctrl-1 = <&mtkfb_pins_lcm_reset0>;
	pinctrl-2 = <&mtkfb_pins_lcm_reset1>;
	pinctrl-3 = <&mtkfb_pins_lcd_bias_enp0>;
	pinctrl-4 = <&mtkfb_pins_lcd_bias_enp1>;
	pinctrl-5 = <&mtkfb_pins_lcd_bias_enn0>;
	pinctrl-6 = <&mtkfb_pins_lcd_bias_enn1>;
	status = "okay";
};

&dispsys_config {
	pinctrl-names = "dispdefault", "lcm_rst_out0_gpio", "lcm_rst_out1_gpio", "lcd_bias_enp0_gpio", "lcd_bias_enp1_gpio", "lcd_bias_enn0_gpio", "lcd_bias_enn1_gpio";
	pinctrl-0 = <&mtkfb_pins_default>;
	pinctrl-1 = <&mtkfb_pins_lcm_reset0>;
	pinctrl-2 = <&mtkfb_pins_lcm_reset1>;
	pinctrl-3 = <&mtkfb_pins_lcd_bias_enp0>;
	pinctrl-4 = <&mtkfb_pins_lcd_bias_enp1>;
	pinctrl-5 = <&mtkfb_pins_lcd_bias_enn0>;
	pinctrl-6 = <&mtkfb_pins_lcd_bias_enn1>;
	helper-value = <0x00 0x01 0x01 0x01 0x01 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x01 0x01 0x01 0x01 0x00 0x01 0x01 0x01 0x00 0x01 0x00 0x01 0x00 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x01 0x00 0x01 0x00 0x00 0x00 0x00>;
	status = "okay";
};

&dsi0 {
	status = "okay";
	#address-cells = <0x01>;
	#size-cells = <0x00>;

	panel1@0 {
		compatible = "ili7807s,fhdp,dsi,vdo,tm,tm,120hz,x6837";
		reg = <0x00>;
		reset-gpios = <&pio 0x55 0x00>;
		bias-gpios = <&pio 0x37 0x00 &pio 0x36 0x00>;
		pinctrl-names = "default";

		port {
			panel_in1: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	panel2@0 {
		compatible = "ft8725,fhdp,dsi,vdo,txd,inx,120hz,x6837";
		reg = <0x01>;
		reset-gpios = <&pio 0x55 0x00>;
		bias-gpios = <&pio 0x37 0x00 &pio 0x36 0x00>;
		pinctrl-names = "default";

		port {
			panel_in2: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	panel3@0 {
		compatible = "ft8725,fhdp,dsi,vdo,lce,inx,120hz,x6837";
		reg = <0x02>;
		reset-gpios = <&pio 0x55 0x00>;
		bias-gpios = <&pio 0x37 0x00 &pio 0x36 0x00>;
		pinctrl-names = "default";

		port {
			panel_in3: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	panel4@0 {
		compatible = "il77600a,fhdp,dsi,vdo,tm,tm,120hz,x6837";
		reg = <0x03>;
		reset-gpios = <&pio 0x55 0x00>;
		bias-gpios = <&pio 0x37 0x00 &pio 0x36 0x00>;
		pinctrl-names = "default";

		port {
			panel_in4: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in1>;
			};
		};
	};
};

&odm {
	led6: led@6 {
		compatible = "mediatek,lcd-backlight";
		led_mode = <0x05>;
		data = <0x01>;
		pwm_config = <0x03 0x00 0x00 0x00 0x00>;
	};

	fingerprint: fingerprint {
		compatible = "tran_fp";
		interrupt-parent = <&pio>;
		interrupts = <0x0d 0x01 0x0d 0x00>;
		debounce = <0x0d 0x00>;
		pinctrl-names = "tran_fp_default", "tran_fp_pin_irq", "tran_fp_irq_pull_down", "tran_fp_reset_high", "tran_fp_reset_low";
		pinctrl-0 = <&fingerprint_default>;
		pinctrl-1 = <&fingerprint_eint>;
		pinctrl-2 = <&fingerprint_eint_pull_down>;
		pinctrl-3 = <&fingerprint_rst_one>;
		pinctrl-4 = <&fingerprint_rst_zero>;
		status = "okay";
	};
};

&spi1 {
	fingerprint@0 {
		compatible = "tran_fp";
		reg = <0x00>;
		spi-max-frequency = <0x19bfcc0>;
		interrupt-parent = <&pio>;
		interrupts = <0x0d 0x01 0x0d 0x00>;
		debounce = <0x0d 0x00>;
		irq-gpio = <0x0d>;
		irq-gpio-std = <&pio 0x0d 0x00>;
		reset-gpio = <0x06>;
		reset-gpio-std = <&pio 0x06 0x00>;
		tran,gpio_pwr = <0x41>;
		tran,gpio_pwr-std = <&pio 0x41 0x00>;
		pinctrl-names = "tran_fp_default", "tran_fp_pin_irq", "tran_fp_irq_pull_down", "tran_fp_reset_high", "tran_fp_reset_low", "tran_fp_spi_default";
		chipone;
		goodix;
		pinctrl-0 = <&fingerprint_default>;
		pinctrl-1 = <&fingerprint_eint>;
		pinctrl-2 = <&fingerprint_eint_pull_down>;
		pinctrl-3 = <&fingerprint_rst_one>;
		pinctrl-4 = <&fingerprint_rst_zero>;
		pinctrl-5 = <&fingerprint_spi_default>;
		status = "okay";
	};
};

&pio {
	fingerprint_default: fingerprint_default {
	};

	fingerprint_eint: gpio13_eint {
		pins_cmd_dat {
			pinmux = <0xd00>;
			slew-rate = <0x00>;
			bias-disable;
		};
	};

	fingerprint_eint_pull_down: gpio13_eint_pull_down {
		pins_cmd_dat {
			pinmux = <0xd00>;
			slew-rate = <0x00>;
			bias-pull-down = <0x00>;
			output-low;
		};
	};

	fingerprint_rst_one: rst_out_one {
		pins_cmd_dat {
			pinmux = <0x600>;
			slew-rate = <0x01>;
			bias-disable;
			output-high;
		};
	};

	fingerprint_rst_zero: rst_out_zero {
		pins_cmd_dat {
			pinmux = <0x600>;
			slew-rate = <0x01>;
			bias-disable;
			output-low;
		};
	};

	fingerprint_spi_default: spimode_default {
		pins_cmd_dat {
			pinmux = <0x2301>;
		};
	};
};

&pio {
	gps_pins_default: gps_default {
	};

	gps_l1_lna_pins_ol: gps_l1_lna@0 {
		pins_cmd_dat {
			pinmux = <0x1900>;
			output-low;
		};
	};

	gps_l1_lna_pins_dsp_ctrl: gps_l1_lna@1 {
		pins_cmd_dat {
			pinmux = <0x1902>;
		};
	};

	gps_l1_lna_pins_oh: gps_l1_lna@2 {
		pins_cmd_dat {
			pinmux = <0x1900>;
			output-high;
		};
	};
};

&gps {
	pinctrl-names = "default", "gps_l1_lna_disable", "gps_l1_lna_dsp_ctrl", "gps_l1_lna_enable";
	pinctrl-0 = <&gps_pins_default>;
	pinctrl-1 = <&gps_l1_lna_pins_ol>;
	pinctrl-2 = <&gps_l1_lna_pins_dsp_ctrl>;
	pinctrl-3 = <&gps_l1_lna_pins_oh>;
	status = "okay";
};

&pio {
	tran_audio: tran_audio {
