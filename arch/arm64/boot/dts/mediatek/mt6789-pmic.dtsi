// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/* MT6789 pmic blocks - split out of the soc node by tools/scripts/dts-socsplit.py */

&soc {
	pwrap: pwrap@10026000 {
		compatible = "mediatek,mt6789-pwrap";
		reg = <0x00 0x10026000 0x00 0x1000>;
		reg-names = "pwrap";
		interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&infracfg_ao_clk CLK_IFRAO_PMIC_AP &infracfg_ao_clk CLK_IFRAO_PMIC_TMR &topckgen_clk CLK_TOP_PWRAP_ULPOSC_SEL &topckgen_clk CLK_TOP_OSC_D10>;
		clock-names = "spi", "wrap", "ulposc", "ulposc_osc";

		pmic: mt6366 {
			compatible = "mediatek,mt6366";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <&pio>;
			interrupts = <0x89 0x04 0x89 0x00>;

			mt63xx_debug {
				compatible = "mediatek,mt63xx-debug";
			};

			mt63xx-oc-debug {
				compatible = "mediatek,mt63xx-oc-debug";
			};

			pmic_efuse: mt6358-efuse {
				compatible = "mediatek,mt6358-efuse";
				#address-cells = <0x01>;
				#size-cells = <0x01>;

				mt6366_thermal_efuse: mt6366_e_data {
					reg = <0x40 0x0c>;
				};
			};

			accdet: accdet {
				compatible = "mediatek,mt6358-accdet";
				accdet-name = "mt6358-accdet";
				accdet-mic-vol = <0x06>;
				headset-mode-setting = <0x500 0x500 0x01 0x1f0 0x800 0x800 0x20 0x44 0x00 0x00 0x0e 0x00 0x00 0x00 0x00 0x00>;
				accdet-plugout-debounce = <0x01>;
				accdet-mic-mode = <0x01>;
				headset-eint-level-pol = <0x08>;
				headset-three-key-threshold = <0x00 0x50 0xdc 0x190>;
				headset-three-key-threshold-CDD = <0x00 0x79 0xc0 0x258>;
				headset-four-key-threshold = <0x00 0x3a 0x79 0xc0 0x190>;
				io-channels = <&pmic_auxadc 9>;
				io-channel-names = "pmic_accdet";
				nvmem = <&pmic_efuse>;
				nvmem-names = "mt63xx-accdet-efuse";
				mediatek,accdet-pmic = <0x66>;
				status = "okay";
			};

			pmic_auxadc: mt635x-auxadc {
				compatible = "mediatek,pmic-auxadc", "mediatek,mt6358-auxadc";
				#io-channel-cells = <0x01>;
				cali-efuse-offset = <0x01>;
				nvmem = <&pmic_efuse>;
				nvmem-names = "auxadc_efuse_dev";

				batadc {
					channel = <0x00>;
					resistance-ratio = <0x03 0x01>;
					avg-num = <0x80>;
				};

				vcdt {
					channel = <0x02>;
				};

				bat_temp {
					channel = <0x03>;
					resistance-ratio = <0x02 0x01>;
				};

				chip_temp {
					channel = <0x05>;
				};

				vcore_temp {
					channel = <0x06>;
				};

				vproc_temp {
					channel = <0x07>;
				};

				vgpu_temp {
					channel = <0x08>;
				};

				accdet {
					channel = <0x09>;
				};

				dcxo_volt {
					channel = <0x0a>;
					resistance-ratio = <0x03 0x02>;
				};

				tsx_temp {
					channel = <0x0b>;
					avg-num = <0x80>;
				};

				hpofs_cal {
					channel = <0x0c>;
					avg-num = <0x100>;
				};

				dcxo_temp {
					channel = <0x0d>;
					avg-num = <0x10>;
				};

				vbif {
					channel = <0x0e>;
					resistance-ratio = <0x02 0x01>;
				};

				imp {
					channel = <0x0f>;
					resistance-ratio = <0x03 0x01>;
					avg-num = <0x80>;
				};

				imix_r {
					channel = <0x10>;
					val = <0x5a>;
				};
			};

			mt6366keys: mt6366keys {
				compatible = "mediatek,mt6366-keys";
				mediatek,long-press-mode = <0x01>;
				power-off-time-sec = <0x00>;

				power {
					linux,keycodes = <0x74>;
					wakeup-source;
				};

				home {
					linux,keycodes = <0x3b>;
				};
			};

			mt6358regulator: mt6358regulator {
				compatible = "mediatek,mt6358-regulator";

				mt6358_vdram1_reg: buck_vdram1 {
					regulator-name = "vdram1";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x1fda4c>;
					regulator-enable-ramp-delay = <0x00>;
					regulator-allowed-modes = <0x00 0x01>;
					regulator-always-on;
				};

				mt6358_vcore_reg: buck_vcore {
					regulator-name = "vcore";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
					regulator-enable-ramp-delay = <0xc8>;
					regulator-always-on;
					regulator-allowed-modes = <0x00 0x01>;
				};

				mt6358_vproc11_reg: buck_vproc11 {
					regulator-name = "vproc11";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
					regulator-enable-ramp-delay = <0xc8>;
					regulator-always-on;
					regulator-allowed-modes = <0x00 0x01>;
				};

				mt6358_vproc12_reg: buck_vproc12 {
					regulator-name = "vproc12";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
					regulator-enable-ramp-delay = <0xc8>;
					regulator-always-on;
					regulator-allowed-modes = <0x00 0x01>;
				};

				mt6358_vgpu_reg: buck_vgpu {
					regulator-name = "vgpu";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
					regulator-enable-ramp-delay = <0xc8>;
					regulator-allowed-modes = <0x00 0x01>;
				};

				mt6358_vs2_reg: buck_vs2 {
					regulator-name = "vs2";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x1fda4c>;
					regulator-enable-ramp-delay = <0x00>;
					regulator-always-on;
				};

				mt6358_vmodem_reg: buck_vmodem {
					regulator-name = "vmodem";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
					regulator-enable-ramp-delay = <0x384>;
					regulator-always-on;
					regulator-allowed-modes = <0x00 0x01>;
				};

				mt6358_vs1_reg: buck_vs1 {
					regulator-name = "vs1";
					regulator-min-microvolt = <0xf4240>;
					regulator-max-microvolt = <0x277b6c>;
					regulator-enable-ramp-delay = <0x00>;
					regulator-always-on;
				};

				mt6358_vdram2_reg: ldo_vdram2 {
					regulator-name = "vdram2";
					regulator-min-microvolt = <0x927c0>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-enable-ramp-delay = <0xce4>;
					regulator-always-on;
				};

				mt6358_vsim1_reg: ldo_vsim1 {
					regulator-name = "vsim1";
					regulator-min-microvolt = <0x00>;
					regulator-max-microvolt = <0x2f4d60>;
					regulator-enable-ramp-delay = <0x21c>;
				};

				mt6358_vibr_reg: ldo_vibr {
					regulator-name = "vibr";
					regulator-min-microvolt = <0x124f80>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-enable-ramp-delay = <0x3c>;
				};

				mt6358_vrf12_reg: ldo_vrf12 {
					compatible = "regulator-fixed";
					regulator-name = "vrf12";
					regulator-min-microvolt = <0x124f80>;
					regulator-max-microvolt = <0x124f80>;
					regulator-enable-ramp-delay = <0x78>;
				};

				mt6358_vio18_reg: ldo_vio18 {
					compatible = "regulator-fixed";
					regulator-name = "vio18";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-enable-ramp-delay = <0xa8c>;
					regulator-always-on;
				};

				mt6358_vusb_reg: ldo_vusb {
					regulator-name = "vusb";
					regulator-min-microvolt = <0x2dc6c0>;
					regulator-max-microvolt = <0x2f4d60>;
					regulator-enable-ramp-delay = <0x10e>;
					regulator-always-on;
				};

				mt6358_vcamio_reg: ldo_vcamio {
					compatible = "regulator-fixed";
					regulator-name = "vcamio";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-enable-ramp-delay = <0x145>;
				};

				mt6358_vcamd_reg: ldo_vcamd {
					regulator-name = "vcamd";
					regulator-min-microvolt = <0xdbba0>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-enable-ramp-delay = <0x145>;
				};

				mt6358_vcn18_reg: ldo_vcn18 {
					compatible = "regulator-fixed";
					regulator-name = "vcn18";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-enable-ramp-delay = <0x10e>;
				};

				mt6358_vfe28_reg: ldo_vfe28 {
					compatible = "regulator-fixed";
					regulator-name = "vfe28";
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
					regulator-enable-ramp-delay = <0x10e>;
				};

				mt6358_vsram_proc11_reg: ldo_vsram_proc11 {
					regulator-name = "vsram_proc11";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
					regulator-enable-ramp-delay = <0xf0>;
					regulator-always-on;
				};

				mt6358_vcn28_reg: ldo_vcn28 {
					compatible = "regulator-fixed";
					regulator-name = "vcn28";
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
					regulator-enable-ramp-delay = <0x10e>;
					regulator-always-on;
				};

				mt6358_vsram_others_reg: ldo_vsram_others {
					regulator-name = "vsram_others";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
					regulator-enable-ramp-delay = <0xf0>;
					regulator-always-on;
				};

				mt6358_vsram_core_reg: ldo_vsram_core {
					regulator-name = "vsram_core";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
					regulator-enable-ramp-delay = <0xf0>;
					regulator-always-on;
				};

				mt6358_vsram_gpu_reg: ldo_vsram_gpu {
					regulator-name = "vsram_gpu";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
					regulator-enable-ramp-delay = <0xf0>;
				};

				mt6358_vxo22_reg: ldo_vxo22 {
					compatible = "regulator-fixed";
					regulator-name = "vxo22";
					regulator-min-microvolt = <0x2191c0>;
					regulator-max-microvolt = <0x2191c0>;
					regulator-enable-ramp-delay = <0x78>;
					regulator-always-on;
				};

				mt6358_vefuse_reg: ldo_vefuse {
					regulator-name = "vefuse";
					regulator-min-microvolt = <0x19f0a0>;
					regulator-max-microvolt = <0x1cfde0>;
					regulator-enable-ramp-delay = <0x10e>;
				};

				mt6358_vaux18_reg: ldo_vaux18 {
					compatible = "regulator-fixed";
					regulator-name = "vaux18";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-enable-ramp-delay = <0x10e>;
					regulator-always-on;
				};

				mt6358_vmch_reg: ldo_vmch {
					regulator-name = "vmch";
					regulator-min-microvolt = <0x2c4020>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-enable-ramp-delay = <0x3c>;
				};

				mt6358_vbif28_reg: ldo_vbif28 {
					compatible = "regulator-fixed";
					regulator-name = "vbif28";
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
					regulator-enable-ramp-delay = <0x10e>;
					regulator-always-on;
				};

				mt6358_vsram_proc12_reg: ldo_vsram_proc12 {
					regulator-name = "vsram_proc12";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
					regulator-enable-ramp-delay = <0xf0>;
					regulator-always-on;
				};

				mt6358_vcama1_reg: ldo_vcama1 {
					regulator-name = "vcama1";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x2dc6c0>;
					regulator-enable-ramp-delay = <0x145>;
				};

				mt6358_vemc_reg: ldo_vemc {
					regulator-name = "vemc";
					regulator-min-microvolt = <0x2c4020>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-enable-ramp-delay = <0x3c>;
				};

				mt6358_vio28_reg: ldo_vio28 {
					compatible = "regulator-fixed";
					regulator-name = "vio28";
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
					regulator-enable-ramp-delay = <0x10e>;
					regulator-always-on;
				};

				mt6358_va12_reg: ldo_va12 {
					compatible = "regulator-fixed";
					regulator-name = "va12";
					regulator-min-microvolt = <0x124f80>;
					regulator-max-microvolt = <0x124f80>;
					regulator-enable-ramp-delay = <0x10e>;
					regulator-always-on;
				};

				mt6358_vrf18_reg: ldo_vrf18 {
					compatible = "regulator-fixed";
					regulator-name = "vrf18";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-enable-ramp-delay = <0x78>;
				};

				mt6358_vcn33_bt_reg: ldo_vcn33_bt {
					regulator-name = "vcn33_bt";
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x10e>;
				};

				mt6358_vcn33_wifi_reg: ldo_vcn33_wifi {
					regulator-name = "vcn33_wifi";
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x10e>;
				};

				mt6358_vcama2_reg: ldo_vcama2 {
					regulator-name = "vcama2";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x2dc6c0>;
					regulator-enable-ramp-delay = <0x145>;
				};

				mt6358_vmc_reg: ldo_vmc {
					regulator-name = "vmc";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-enable-ramp-delay = <0x3c>;
				};

				mt6358_vldo28_reg: ldo_vldo28 {
					regulator-name = "vldo28";
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2dc6c0>;
					regulator-enable-ramp-delay = <0x10e>;
				};

				mt6358_vaud28_reg: ldo_vaud28 {
					compatible = "regulator-fixed";
					regulator-name = "vaud28";
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
					regulator-enable-ramp-delay = <0x10e>;
					regulator-always-on;
				};

				mt6358_vsim2_reg: ldo_vsim2 {
					regulator-name = "vsim2";
					regulator-min-microvolt = <0x00>;
					regulator-max-microvolt = <0x2f4d60>;
					regulator-enable-ramp-delay = <0x21c>;
				};

				mt6358_vcore_sshub_reg: buck_vcore_sshub {
					regulator-name = "vcore_sshub";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
				};

				mt6358_vsram_others_sshub_reg: ldo_vsram_others_sshub {
					regulator-name = "vsram_others_sshub";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13bdb6>;
				};

				mt6358_va09_reg: ldo_va09 {
					regulator-name = "va09";
					compatible = "regulator-fixed";
					regulator-min-microvolt = <0xdbba0>;
					regulator-max-microvolt = <0xdbba0>;
					regulator-enable-ramp-delay = <0x108>;
				};

				mt6358_vmch_eint_high: VMCH_EINT_HIGH {
					regulator-name = "mt6358_vmch_eint_high";
					regulator-min-microvolt = <0x2c4020>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-enable-ramp-delay = <0x3c>;
				};

				mt6358_vmch_eint_low: VMCH_EINT_LOW {
					regulator-name = "mt6358_vmch_eint_low";
					regulator-min-microvolt = <0x2c4020>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-enable-ramp-delay = <0x3c>;
				};
			};

			mt6366_clock_buffer: mt6366_clock_buffer {
				compatible = "mediatek,clock_buffer";
				mediatek,xo-mode-num = <0x04>;
				mediatek,xo-buf-support = <0x01 0x01 0x01 0x01 0x00 0x00 0x01>;
				mediatek,xo-buf-allow-control = <0x00 0x01 0x01 0x01 0x00 0x00 0x01>;
				mediatek,xo-buf-name = "XO_SOC", "XO_WCN", "XO_NFC", "XO_CEL", "RSV1", "RSV2", "XO_EXT";
				mediatek,dcxo-drv-curr-support;
				mediatek,clkbuf-pmic-central-base;
				mediatek,enable;
				clkbuf_ctl = <&clock_buffer_ctrl>;
			};

			mt6358_dynamic_loading_throttling: mtk_dynamic_loading_throttling {
				compatible = "mediatek,mt6358-dynamic_loading_throttling";
				uvlo-level = <0xa28>;
				io-channels = <&pmic_auxadc 15 &pmic_auxadc 16 &pmic_auxadc 0>;
				io-channel-names = "pmic_ptim", "pmic_imix_r", "pmic_batadc";
				bootmode = <&chosen>;
			};

			mt6358_lbat: pmic_lbat_service {
				compatible = "mediatek,mt6358-lbat_service";
			};

			mt6358codec: mt6358codec {
				compatible = "mediatek,mt6366-sound";
				mediatek,dmic-mode = <0x00>;
				mediatek,mic-type = <0x01>;
				io-channels = <&pmic_auxadc 12>;
				io-channel-names = "pmic_hpofs_cal";
				nvmem = <&pmic_efuse>;
				nvmem-names = "pmic-hp-efuse";
				reg_vaud28-supply = <&mt6358_vaud28_reg>;
			};

			mt6358rtc: mt6358rtc {
				compatible = "mediatek,mt6358-rtc";
				skip-lpsd-solution;
				#address-cells = <0x01>;
				#size-cells = <0x01>;

				fg_init: fg_init {
					reg = <0x00 0x01>;
				};

				fg_soc: fg_soc {
					reg = <0x01 0x01>;
				};

				ext_32k: ext_32k {
					reg = <0x02 0x01>;
					bits = <0x06 0x01>;
				};
			};

			mtk_gauge: mtk_gauge {
				compatible = "mediatek,mt6358-gauge";
				bootmode = <&chosen>;
				io-channels = <&pmic_auxadc 0x03 &pmic_auxadc 0x00 &pmic_auxadc 0x0e &pmic_auxadc 0x0f &auxadc 0x04 &pmic_auxadc 0x10>;
				io-channel-names = "pmic_battery_temp", "pmic_battery_voltage", "pmic_bif_voltage", "pmic_ptim_voltage", "batteryID-channel", "pmic_ptim_r";
				nvmem-cells = <&fg_init &fg_soc>;
				nvmem-cell-names = "initialization", "state-of-charge";
				charger = <&mt6375_chg>;
				DIFFERENCE_FULLOCV_ITH = <0xc8>;
				SHUTDOWN_1_TIME = <0x1e>;
				KEEP_100_PERCENT = <0x01>;
				R_FG_VALUE = <0x05>;
				EMBEDDED_SEL = <0x01>;
				PMIC_SHUTDOWN_CURRENT = <0x14>;
				FG_METER_RESISTANCE = <0x64>;
				CAR_TUNE_VALUE = <0x64>;
				PMIC_MIN_VOL = <0x82dc>;
				POWERON_SYSTEM_IBOOT = <0x1f4>;
				SHUTDOWN_GAUGE0_VOLTAGE = <0x84d0>;
				TEMPERATURE_T0 = <0x32>;
				TEMPERATURE_T1 = <0x19>;
				TEMPERATURE_T2 = <0x0a>;
				TEMPERATURE_T3 = <0x00>;
				TEMPERATURE_T4 = <0xfffffff6>;
				g_FG_PSEUDO100_T0 = <0x64>;
				g_FG_PSEUDO100_T1 = <0x64>;
				g_FG_PSEUDO100_T2 = <0x64>;
				g_FG_PSEUDO100_T3 = <0x64>;
