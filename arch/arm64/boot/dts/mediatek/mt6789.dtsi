	soc: soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;
	};

	mtk_lpm: mtk_lpm {
		compatible = "mediatek,mtk-lpm";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		lpm-kernel-suspend = <0x00>;
		suspend-method = "enable";
		logger-enable-states = "mcusysoff", "system_mem", "system_pll", "system_bus";
		irq-remain = <&edge_keypad &edge_mdwdt &level_btif_tx &level_btif_rx &level_usb>;
		resource-ctrl = <&bus26m &infra &syspll &dram_s0 &dram_s1>;
		constraints = <&rc_bus26m &rc_syspll &rc_dram &rc_cpu_buck_ldo>;
		spm-cond = <&spm_cond_cg &spm_cond_pll>;
		cg-shift = <0x00>;
		pll-shift = <0x10>;
		power-gs = <0x00>;
		mcusys-cnt-chk = <0x01>;

		cpupm_sysram: cpupm-sysram@11b000 {
			compatible = "mediatek,cpupm-sysram";
			reg = <0x00 0x11b000 0x00 0x500>;
		};

		mcusys_ctrl: mcusys-ctrl@c53a000 {
			compatible = "mediatek,mcusys-ctrl";
			reg = <0x00 0xc53a000 0x00 0x1000>;
		};

		lpm_sysram: lpm_sysram@11b500 {
			compatible = "mediatek,lpm-sysram";
			reg = <0x00 0x11b500 0x00 0x300>;
		};

		irq-remain-list {

			edge_keypad: edge_keypad {
				target = <&keypad>;
				value = <0x01 0x00 0x00 0x04>;
			};

			edge_mdwdt: edge_mdwdt {
				target = <&mddriver>;
				value = <0x01 0x00 0x80000000 0x2000000>;
			};

			level_btif_tx: level_btif_tx {
				target = <&btif>;
				value = <0x00 0x01 0x00 0x00>;
			};

			level_btif_rx: level_btif_rx {
				target = <&btif>;
				value = <0x00 0x02 0x00 0x00>;
			};

			level_usb: level_usb {
				target = <&usb>;
				value = <0x00 0x00 0x00 0x00>;
			};
		};

		resource-ctrl-list {

			bus26m: bus26m {
				id = <0x00>;
				value = <0x00>;
			};

			infra: infra {
				id = <0x01>;
				value = <0x00>;
			};

			syspll: syspll {
				id = <0x02>;
				value = <0x00>;
			};

			dram_s0: dram_s0 {
				id = <0x03>;
				value = <0x00>;
			};

			dram_s1: dram_s1 {
				id = <0x04>;
				value = <0x00>;
			};
		};

		constraint-list {

			rc_bus26m: rc_bus26m {
				rc-name = "bus26m";
				id = <0x00>;
				value = <0x01>;
				cond-info = <0x01>;
			};

			rc_syspll: rc_syspll {
				rc-name = "syspll";
				id = <0x01>;
				value = <0x01>;
				cond-info = <0x01>;
			};

			rc_dram: rc_dram {
				rc-name = "dram";
				id = <0x02>;
				value = <0x01>;
				cond-info = <0x01>;
			};

			rc_cpu_buck_ldo: rc_cpu_buck_ldo {
				rc-name = "cpu-buck-ldo";
				id = <0x03>;
				value = <0x01>;
				cond-info = <0x00>;
			};
		};

		spm-cond-list {

			spm_cond_cg: spm_cond_cg {
				cg-name = "MTCMOS_0", "INFRA_0", "INFRA_1", "INFRA_2", "INFRA_3", "INFRA_4", "MMSYS_0", "MMSYS_3";
			};

			spm_cond_pll: spm_cond_pll {
				pll-name = "UNIVPLL", "MFGPLL", "MSDCPLL", "TVPLL", "MMPLL";
			};
		};

		power-gs-list {
		};
	};

