	clkchk {
		compatible = "mediatek,mt6789-clkchk";
	};

	pdchk {
		compatible = "mediatek,mt6789-pdchk";
	};

	clocks {

		clk32k: clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
		};

		clk26m: clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x18cba80>;
		};

		clk13m: clk13m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xc65d40>;
		};

		ulposc: ulposc {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xf7f4900>;
		};
	};

	cpuhvfs: cpuhvfs@114400 {
		compatible = "mediatek,cpufreq-hybrid";
		reg = <0x00 0x114400 0x00 0xc00 0x00 0x11bc00 0x00 0x1400 0x00 0x112800 0x00 0x1800 0x00 0x114f40 0x00 0xc0>;
		reg-names = "USRAM", "CSRAM", "ESRAM";
		cslog-range = <0x3d0 0xfa0>;
		tbl-off = <0x04 0x4c 0x94>;
		mcucfg-ver = <0x00>;
		apmixedsys = <&cpu_pll>;
		clk-div-base = <&cpu_mcucfg>;
		pll-con = <0x20c 0x21c 0x25c>;
		clk-div = <0xa2a0 0xa2a4 0xa2e0>;
		proc1-supply = <&mt6358_vproc11_reg>;
		proc2-supply = <&mt6358_vproc12_reg>;
		proc3-supply = <&mt6358_vproc11_reg>;
		nvmem-cells = <&lkginfo>;
		nvmem-cell-names = "lkginfo";
	};

	topckgen_clk: syscon@10000000 {
		compatible = "mediatek,mt6789-topckgen", "syscon";
		reg = <0x00 0x10000000 0x00 0x1000>;
		#clock-cells = <0x01>;
	};

	infracfg_ao_clk: syscon@10001000 {
		compatible = "mediatek,mt6789-infracfg_ao", "syscon", "simple-mfd";
		reg = <0x00 0x10001000 0x00 0x1000>;
		#clock-cells = <0x01>;

		infracfg_rst: reset-controller {
			compatible = "ti,syscon-reset";
			#reset-cells = <0x01>;
			ti,reset-bits = <0x120 0x00 0x124 0x00 0x00 0x00 0x1c 0x130 0x0f 0x134 0x0f 0x00 0x00 0x1c 0x140 0x07 0x144 0x07 0x00 0x00 0x1c 0x150 0x15 0x154 0x15 0x00 0x00 0x1c>;
		};
	};

	scpsys: power-controller@10006000 {
		compatible = "mediatek,mt6789-scpsys", "syscon";
		reg = <0x00 0x10006000 0x00 0x1000>;
		#power-domain-cells = <0x01>;
		clocks = <&topckgen_clk CLK_TOP_MFG_REF_SEL &topckgen_clk CLK_TOP_IMG1_SEL &topckgen_clk CLK_TOP_IPE_SEL &topckgen_clk CLK_TOP_VDEC_SEL &topckgen_clk CLK_TOP_VENC_SEL &topckgen_clk CLK_TOP_MDP_SEL &topckgen_clk CLK_TOP_DISP_SEL &topckgen_clk CLK_TOP_AUD_INTBUS_SEL &topckgen_clk CLK_TOP_CAM_SEL &imgsys1_clk CLK_IMGSYS1_GALS &imgsys1_clk CLK_IMGSYS1_LARB9 &ipesys_clk CLK_IPE_SMI_SUBCOM &ipesys_clk CLK_IPE_GALS &ipesys_clk CLK_IPE_LARB19 &ipesys_clk CLK_IPE_LARB20 &vdec_gcon_base_clk CLK_VDE2_VDEC_CKEN &vdec_gcon_base_clk CLK_VDE2_LARB1_CKEN &venc_gcon_clk CLK_VEN1_CKE1_VENC &mdpsys_config_clk CLK_MDP_SMI0 &dispsys_config_clk CLK_MM_SMI_INFRA &dispsys_config_clk CLK_MM_SMI_COMMON &dispsys_config_clk CLK_MM_SMI_GALS &dispsys_config_clk CLK_MM_SMI_IOMMU &infracfg_ao_clk CLK_IFRAO_AUDIO_26M_BCLK &infracfg_ao_clk CLK_IFRAO_AUDIO &camsys_main_clk CLK_CAM_M_LARB13 &camsys_main_clk CLK_CAM_M_LARB14 &camsys_rawa_clk CLK_CAM_RA_LARBX &camsys_rawb_clk CLK_CAM_RB_LARBX>;
		clock-names = "mfg", "isp", "ipe", "vdec", "venc", "mdp", "disp", "audio", "cam", "isp-0", "isp-1", "ipe-0", "ipe-1", "ipe-2", "ipe-3", "vdec-0", "vdec-1", "venc-0", "disp_lp-0", "disp-0", "disp-1", "disp-2", "disp-3", "audio-0", "audio-1", "cam-0", "cam-1", "cam_rawa-0", "cam_rawb-0";
		infracfg = <&infracfg_ao_clk>;
	};

	apmixedsys_clk: syscon@1000C000 {
		compatible = "mediatek,mt6789-apmixedsys", "syscon";
		reg = <0x00 0x1000c000 0x00 0x1000>;
		#clock-cells = <0x01>;
	};

	fhctl: fhctl@1000ce00 {
		compatible = "mediatek,mt6853-fhctl";
		reg = <0x00 0x1000ce00 0x00 0x200 0x00 0x1000c000 0x00 0xe00>;

		map0 {
			domain = "top";
			method = "fhctl-mcupm";

			armpll_ll {
				fh-id = <0x00>;
				pll-id = <0x3e7>;
				perms = <0x1c>;
			};

			armpll_bl0 {
				fh-id = <0x01>;
				pll-id = <0x3e7>;
				perms = <0x1c>;
			};

			armpll_bl1 {
				fh-id = <0x02>;
				pll-id = <0x3e7>;
				perms = <0x1c>;
			};

			armpll_bl2 {
				fh-id = <0x03>;
				pll-id = <0x3e7>;
				perms = <0x1c>;
			};

			npupll {
				fh-id = <0x04>;
				pll-id = <0x08>;
			};

			ccipll {
				fh-id = <0x05>;
				pll-id = <0x3e7>;
				perms = <0x1c>;
			};

			mfgpll {
				fh-id = <0x06>;
				pll-id = <0x09>;
			};

			mpll {
				fh-id = <0x08>;
				pll-id = <0x3e7>;
				perms = <0x1c>;
			};

			mmpll {
				fh-id = <0x09>;
				pll-id = <0x07>;
			};

			mainpll {
				fh-id = <0x0a>;
				pll-id = <0x04>;
			};

			msdcpll {
				fh-id = <0x0b>;
				pll-id = <0x06>;
			};

			tvdpll {
				fh-id = <0x0e>;
				pll-id = <0x0a>;
			};
		};
	};

	cam_qos_legacy {
