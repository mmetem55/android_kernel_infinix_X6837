		mediatek,action = <0x01>;
		clocks = <&topckgen_clk CLK_TOP_DISP_SEL &topckgen_clk CLK_TOP_VENC_SEL &topckgen_clk CLK_TOP_VDEC_SEL &topckgen_clk CLK_TOP_MDP_SEL &topckgen_clk CLK_TOP_CAM_SEL &topckgen_clk CLK_TOP_IMG1_SEL &topckgen_clk CLK_TOP_IPE_SEL &topckgen_clk CLK_TOP_MAINPLL_D4 &topckgen_clk CLK_TOP_UNIVPLL_D6 &topckgen_clk CLK_TOP_UNIVPLL_D4_D2 &topckgen_clk CLK_TOP_UNIVPLL_D6_D2 &topckgen_clk CLK_TOP_TVDPLL &topckgen_clk CLK_TOP_MAINPLL_D5 &topckgen_clk CLK_TOP_MMPLL_D4_D2 &topckgen_clk CLK_TOP_MMPLL_D5_D2 &topckgen_clk CLK_TOP_UNIVPLL_D4 &topckgen_clk CLK_TOP_MMPLL_D6 &topckgen_clk CLK_TOP_MMPLL_D7 &topckgen_clk CLK_TOP_NPUPLL &topckgen_clk CLK_TOP_MAINPLL_D6 &topckgen_clk CLK_TOP_UNIVPLL_D5_D2 &topckgen_clk CLK_TOP_MAINPLL_D5_D2 &apmixedsys_clk CLK_APMIXED_MMPLL>;
