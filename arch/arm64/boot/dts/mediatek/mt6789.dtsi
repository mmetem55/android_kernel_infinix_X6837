// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * MediaTek MT6789 (Helio G99) silicon as seen by the iKKO MindOne stock device tree.
 * Split out of the flat decompiled tree by tools/scripts/dts-split.py; the board file
 * mindone.dts includes this and adds what is specific to the phone.
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>

#include <dt-bindings/power/mt6789-power.h>

#include <dt-bindings/clock/mt6789-clk.h>

#include <dt-bindings/pinctrl/mt6789-pinfunc.h>

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "MT6789";
	compatible = "mediatek,MT6789";
	interrupt-parent = <&gic>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			performance-domains = <&performance 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff &system_mem &system_pll &system_bus &s2idle>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			performance-domains = <&performance 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff &system_mem &system_pll &system_bus &s2idle>;
			#cooling-cells = <2>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			performance-domains = <&performance 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff &system_mem &system_pll &system_bus &s2idle>;
			#cooling-cells = <2>;
		};

		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			performance-domains = <&performance 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff &system_mem &system_pll &system_bus &s2idle>;
			#cooling-cells = <2>;
		};

		cpu4: cpu@4 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			performance-domains = <&performance 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff &system_mem &system_pll &system_bus &s2idle>;
			#cooling-cells = <2>;
		};

		cpu5: cpu@5 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			performance-domains = <&performance 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff &system_mem &system_pll &system_bus &s2idle>;
			#cooling-cells = <2>;
		};

		cpu6: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x600>;
			performance-domains = <&performance 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <&cpuoff_b &clusteroff_b &mcusysoff &system_mem &system_pll &system_bus &s2idle>;
			#cooling-cells = <2>;
		};

		cpu7: cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x700>;
			performance-domains = <&performance 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <&cpuoff_b &clusteroff_b &mcusysoff &system_mem &system_pll &system_bus &s2idle>;
			#cooling-cells = <2>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};

				core4 {
					cpu = <&cpu4>;
				};

				core5 {
					cpu = <&cpu5>;
				};
			};

			cluster1 {

				core0 {
					cpu = <&cpu6>;
				};

				core1 {
					cpu = <&cpu7>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff_l: cpuoff_l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10001>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x640>;
			};

			cpuoff_b: cpuoff_b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10002>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x578>;
			};

			clusteroff_l: clusteroff_l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010101>;
				local-timer-stop;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x834>;
			};

			clusteroff_b: clusteroff_b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010102>;
				local-timer-stop;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x76c>;
			};

			mcusysoff: mcusysoff {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010701>;
				local-timer-stop;
				entry-latency-us = <0x1c2>;
				exit-latency-us = <0x258>;
				min-residency-us = <0xfa0>;
			};

			system_mem: system_mem {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010f01>;
				local-timer-stop;
				entry-latency-us = <0x2bc>;
				exit-latency-us = <0x352>;
				min-residency-us = <0xfa0>;
			};

			system_pll: system_pll {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010f02>;
				local-timer-stop;
				entry-latency-us = <0x320>;
				exit-latency-us = <0x3b6>;
				min-residency-us = <0xfa0>;
			};

			system_bus: system_bus {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010f03>;
				local-timer-stop;
				entry-latency-us = <0x514>;
				exit-latency-us = <0xaf0>;
				min-residency-us = <0xfa0>;
			};

			s2idle: s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1011f01>;
				local-timer-stop;
				entry-latency-us = <0x2710>;
				exit-latency-us = <0x2710>;
				min-residency-us = <0xffffffff>;
			};
		};
	};

	swpm: swpm {
		compatible = "mediatek,mtk-swpm";
		pmu_boundary_num = <0x06>;
		pmu_dsu_support = <0x00>;
		pmu_dsu_type = <0x09>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	lastbus: lastbus {
		compatible = "mediatek,lastbus";
		enabled = <0x01>;
		sw_version = <0x01>;
		timeout_ms = <0xc8>;
		timeout_type = <0x00>;

		monitors {

			monitor1 {
				monitor_name = "debug_ctrl_ao_PERI_AO";
				base = <0x1002b000>;
				num_ports = <0x22>;
				bus_freq_mhz = <0x4e>;
			};

			monitor2 {
				monitor_name = "debug_ctrl_ao_FMEM_AO";
				base = <0x10042000>;
				num_ports = <0x0e>;
				bus_freq_mhz = <0x4e>;
			};

			monitor3 {
				monitor_name = "debug_ctrl_ao_PERI_AO2";
				base = <0x1002e000>;
				num_ports = <0x13>;
				bus_freq_mhz = <0x4e>;
			};

			monitor4 {
				monitor_name = "debug_ctrl_ao_PERI_PAR_AO";
				base = <0x10040000>;
				num_ports = <0x06>;
				bus_freq_mhz = <0x4e>;
			};

			monitor5 {
				monitor_name = "debug_ctrl_ao_INFRA_AO";
				base = <0x10023000>;
				num_ports = <0x16>;
				bus_freq_mhz = <0x4e>;
			};
		};
	};

	firmware: firmware {

		scmi: scmi {
			compatible = "arm,scmi";
			mboxes = <&tinysys_mbox 0 &tinysys_mbox 1>;
			shmem = <&scmi_tx_shmem &scmi_rx_shmem>;
			mbox-names = "tx", "rx";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			scmi_tinysys: protocol@80 {
				reg = <0x80>;
				scmi_qos = <0x01>;
				scmi_pmic = <0x02>;
				scmi_met = <0x03>;
				scmi_gpupm = <0x04>;
				scmi_plt = <0x05>;
				scmi_smi = <0x06>;
				scmi_cm = <0x07>;
				scmi_apmcupm = <0x08>;
			};
		};

		android: android {
			compatible = "android,firmware";
			hardware = "mt6789";
		};
	};

	sspm: sspm@10400000 {
		compatible = "mediatek,sspm";
		reg = <0x00 0x10400000 0x00 0x30000 0x00 0x10440000 0x00 0x10000 0x00 0x10480000 0x00 0x80>;
		reg-names = "sspm_base", "cfgreg", "mbox_share";
		interrupts = <GIC_SPI 273 IRQ_TYPE_LEVEL_HIGH 0>;
		interrupt-names = "ipc";
		sspm_res_ram_start = <0x00>;
		sspm_res_ram_size = <0x110000>;
	};

	ssram1@10450000 {
		compatible = "mmio-sram_1";
		reg = <0x00 0x10450000 0x00 0x80>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x10450000 0x80>;

		scmi_tx_shmem: tiny_mbox@0 {
			compatible = "arm,scmi-tx-shmem", "arm,scmi-shmem";
			reg = <0x00 0x80>;
		};
	};

	ssram2@10460000 {
		compatible = "mmio-sram_2";
		reg = <0x00 0x10460000 0x00 0x80>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x10460000 0x80>;

		scmi_rx_shmem: tiny_mbox@1 {
			compatible = "arm,scmi-rx-shmem", "arm,scmi-shmem";
			reg = <0x00 0x80>;
		};
	};

	tinysys_mbox: tinysys_mbox@10451000 {
		compatible = "mediatek,tinysys_mbox";
		reg = <0x00 0x10451000 0x00 0x1000 0x00 0x10461000 0x00 0x1000>;
		shmem = <&scmi_tx_shmem &scmi_rx_shmem>;
		interrupts = <GIC_SPI 276 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 277 IRQ_TYPE_LEVEL_HIGH 0>;
		#mbox-cells = <0x01>;
	};

	mrdump_ext_rst: mrdump_ext_rst {
		compatible = "mediatek, mrdump_ext_rst-eint";
		mode = "IRQ";
		status = "okay";
	};

	gic: interrupt-controller {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x04>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		#redistributor-regions = <0x01>;
		interrupt-parent = <&gic>;
		interrupt-controller;
		reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc040000 0x00 0x200000>;
		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	therm_intf: therm_intf@114000 {
		compatible = "mediatek,therm_intf";
		reg = <0x00 0x114000 0x00 0x400>;
		reg-names = "therm_sram";
	};

	qos: qos@11bb00 {
		compatible = "mediatek,mt6893-qos";
		mediatek,qos_enable = <0x01>;
		reg = <0x00 0x11bb00 0x00 0x100>;
	};

	cm_mgr: cm_mgr@c530000 {
		compatible = "mediatek,mt6789-cm_mgr";
		reg = <0x00 0xc530000 0x00 0x9000>;
		reg-names = "cm_mgr_base";
		interconnects = <&dvfsrc 0x01 &dvfsrc 0x00>;
		interconnect-names = "cm-perf-bw";
		required-opps = <&dvfsrc_freq_opp0 &dvfsrc_freq_opp1 &dvfsrc_freq_opp2 &dvfsrc_freq_opp3 &dvfsrc_freq_opp4 &dvfsrc_freq_opp5 &dvfsrc_freq_opp6>;
		cm_mgr,cp_down = <0x8c 0x8c 0x32 0x64 0x64 0x64>;
		cm_mgr,cp_up = <0xa0 0xa0 0x32 0x64 0x64 0x64>;
		cm_mgr,dt_down = <0x03 0x03 0x00 0x00 0x00 0x00>;
		cm_mgr,dt_up = <0x00 0x00 0x00 0x00 0x00 0x00>;
		cm_mgr,vp_down = <0x64 0x64 0x64 0x64 0x64 0x64>;
		cm_mgr,vp_up = <0x64 0x64 0x64 0x64 0x64 0x64>;
		use_bcpu_weight = "enable";
		cpu_power_bcpu_weight_max = <0xc8>;
		cpu_power_bcpu_weight_min = <0x64>;
	};

	fpsgo: fpsgo {
		compatible = "mediatek,fpsgo";
		status = "disabled";
		interconnects = <&dvfsrc 0x01 &dvfsrc 0x00>;
		interconnect-names = "fpsgo-perf-bw";
		required-opps = <&dvfsrc_freq_opp0>;
		gcc_enable = <0x01>;
		fbt_cpu_mask = <0xff 0xc0 0x3f 0xff>;
		sbe_resceue_enable = <0x01>;
	};

	mcupm: mcupm@c540000 {
		compatible = "mediatek,mcupm";
		reg = <0x00 0xc540000 0x00 0x22000 0x00 0xc55fb00 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc560074 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc560078 0x00 0x04 0x00 0xc55fba0 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc560074 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc560078 0x00 0x04 0x00 0xc55fc40 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc560074 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc560078 0x00 0x04 0x00 0xc55fce0 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc560074 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc560078 0x00 0x04 0x00 0xc55fd80 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc560074 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc560078 0x00 0x04 0x00 0xc55fe20 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc560074 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc560078 0x00 0x04 0x00 0xc55fec0 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc560074 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc560078 0x00 0x04 0x00 0xc55ff60 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc560074 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc560078 0x00 0x04>;
		reg-names = "mcupm_base", "mbox0_base", "mbox0_set", "mbox0_clr", "mbox0_send", "mbox0_recv", "mbox1_base", "mbox1_set", "mbox1_clr", "mbox1_send", "mbox1_recv", "mbox2_base", "mbox2_set", "mbox2_clr", "mbox2_send", "mbox2_recv", "mbox3_base", "mbox3_set", "mbox3_clr", "mbox3_send", "mbox3_recv", "mbox4_base", "mbox4_set", "mbox4_clr", "mbox4_send", "mbox4_recv", "mbox5_base", "mbox5_set", "mbox5_clr", "mbox5_send", "mbox5_recv", "mbox6_base", "mbox6_set", "mbox6_clr", "mbox6_send", "mbox6_recv", "mbox7_base", "mbox7_set", "mbox7_clr", "mbox7_send", "mbox7_recv";
		interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH 0>;
		interrupt-names = "mbox0", "mbox1", "mbox2", "mbox3", "mbox4", "mbox5", "mbox6", "mbox7";
	};

	utos: utos {
		compatible = "microtrust,utos";
		interrupts = <GIC_SPI 118 IRQ_TYPE_EDGE_RISING 0>;
	};

	utos_tester {
		compatible = "microtrust,tester-v1";
	};

	timer: timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_HIGH 0 GIC_PPI 14 IRQ_TYPE_LEVEL_HIGH 0 GIC_PPI 11 IRQ_TYPE_LEVEL_HIGH 0 GIC_PPI 10 IRQ_TYPE_LEVEL_HIGH 0>;
		clock-frequency = <0xc65d40>;
	};

	hwrng: hwrng {
		compatible = "arm,sec-rng";
		methods = "smc";
		method-fid = [02 6a];
		quality = [03 84];
	};

	atf_logger: atf_logger {
		compatible = "mediatek,tfa_debug";
	};

	cache-parity {
		compatible = "mediatek,mt6873-cache-parity";
		ecc-irq-support = <0x01>;
		arm_dsu_ecc_hwirq = <0x20>;
		interrupts = <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH 0 GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	dcm: dcm@10001000 {
		compatible = "mediatek,mt6789-dcm";
		reg = <0x00 0x10001000 0x00 0x1000 0x00 0x10022000 0x00 0x1000 0x00 0xc530000 0x00 0x5000 0x00 0xc538000 0x00 0x5000 0x00 0xc53a800 0x00 0x1000>;
		reg-names = "infracfg_ao", "infra_ao_bcrm", "mcusys_par_wrap", "mp_cpusys_top", "cpccfg_reg";
	};

	clk_ao: clk_ao {
		compatible = "simple-bus";
	};

	clkitg: clkitg {
		compatible = "simple-bus";
		status = "okay";

		bring-up {
			compatible = "mediatek,clk-bring-up";
			clocks = <&topckgen_clk CLK_TOP_PWRAP_ULPOSC_SEL &topckgen_clk CLK_TOP_ATB_SEL &topckgen_clk CLK_TOP_DPMAIF_MAIN_SEL &infracfg_ao_clk CLK_IFRAO_PMIC_TMR &infracfg_ao_clk CLK_IFRAO_PMIC_AP &infracfg_ao_clk CLK_IFRAO_THERM &infracfg_ao_clk CLK_IFRAO_BTIF &infracfg_ao_clk CLK_IFRAO_CCIF1_AP &infracfg_ao_clk CLK_IFRAO_CCIF1_MD &infracfg_ao_clk CLK_IFRAO_CCIF_AP &infracfg_ao_clk CLK_IFRAO_DEBUGSYS &infracfg_ao_clk CLK_IFRAO_CCIF_MD &infracfg_ao_clk CLK_IFRAO_CLDMA_BCLK &infracfg_ao_clk CLK_IFRAO_CCIF5_MD &infracfg_ao_clk CLK_IFRAO_CCIF2_AP &infracfg_ao_clk CLK_IFRAO_CCIF2_MD &infracfg_ao_clk CLK_IFRAO_CCIF4_AP &infracfg_ao_clk CLK_IFRAO_CCIF4_MD &infracfg_ao_clk CLK_IFRAO_66MP_BUS_MCLK_CKP>;
		};
	};

	disable_unused: disable_unused {
		compatible = "simple-bus";
		status = "okay";

		disable-unused-clk-mdpsys {
			compatible = "mediatek,clk-disable-unused";
			clocks = <&mdpsys_config_clk CLK_MDP_RDMA0 &mdpsys_config_clk CLK_MDP_TDSHP0 &mdpsys_config_clk CLK_MDP_IMG_DL_ASYNC0 &mdpsys_config_clk CLK_MDP_IMG_DL_ASYNC1 &mdpsys_config_clk CLK_MDP_SMI0 &mdpsys_config_clk CLK_MDP_APB_BUS &mdpsys_config_clk CLK_MDP_WROT0 &mdpsys_config_clk CLK_MDP_RSZ0 &mdpsys_config_clk CLK_MDP_HDR0 &mdpsys_config_clk CLK_MDP_MUTEX0 &mdpsys_config_clk CLK_MDP_WROT1 &mdpsys_config_clk CLK_MDP_RSZ1 &mdpsys_config_clk CLK_MDP_FAKE_ENG0 &mdpsys_config_clk CLK_MDP_AAL0 &mdpsys_config_clk CLK_MDP_IMG_DL_RELAY0_ASYNC0 &mdpsys_config_clk CLK_MDP_IMG_DL_RELAY1_ASYNC1>;
			power-domains = <&scpsys MT6789_POWER_DOMAIN_DISP>;
		};

		disable-unused-clk-ipesys {
			compatible = "mediatek,clk-disable-unused";
			clocks = <&ipesys_clk CLK_IPE_LARB19 &ipesys_clk CLK_IPE_LARB20 &ipesys_clk CLK_IPE_SMI_SUBCOM &ipesys_clk CLK_IPE_FD &ipesys_clk CLK_IPE_FE &ipesys_clk CLK_IPE_RSC &ipesys_clk CLK_IPE_DPE &ipesys_clk CLK_IPE_GALS>;
			power-domains = <&scpsys MT6789_POWER_DOMAIN_IPE>;
		};

		disable-unused-clk-camsys_rawb {
			compatible = "mediatek,clk-disable-unused";
