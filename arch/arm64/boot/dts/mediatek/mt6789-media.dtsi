		};
	};

	mdpsys-bus {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		dma-ranges = <0x02 0x00 0x02 0x00 0x01 0x00>;

		mdpsys_config: mdpsys_config@1f000000 {
			#address-cells = <2>;
			#size-cells = <2>;
			compatible = "mediatek,mdpsys_config", "syscon";
			reg = <0x00 0x1f000000 0x00 0x1000>;
			clocks = <&mdpsys_config_clk CLK_MDP_IMG_DL_ASYNC0 &mdpsys_config_clk CLK_MDP_IMG_DL_ASYNC1 &mdpsys_config_clk CLK_MDP_IMG_DL_RELAY0_ASYNC0 &mdpsys_config_clk CLK_MDP_IMG_DL_RELAY1_ASYNC1 &mdpsys_config_clk CLK_MDP_APB_BUS>;
